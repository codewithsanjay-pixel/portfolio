# Names only. Never put real values in this file.
# Copy to .env.local for local work; set the same names in Vercel for production.

# Postgres with pgvector (Neon). Owner role: used only by the ingest script.
DATABASE_URL=
# Read-only role: the only database access the chat route has (docs/DB.md).
DATABASE_URL_READONLY=

# Upstash Redis, for rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenAI (ADR 007): one project-specific key, used for embeddings and answers.
OPENAI_API_KEY=
# Model names from OpenAI's docs, not hard-coded. Embedding size must match db/schema.sql.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LLM_MODEL=
# Optional: none, low (default), medium or high.
LLM_REASONING_EFFORT=

# Number of chunks retrieved per question (default 5, max 20).
RETRIEVAL_TOP_K=
# Optional. Scope check threshold (ADR 008): minimum similarity of the best chunk, 0 to 1 (default 0.25).
SCOPE_MIN_SCORE=

# Private words the chat must never say, separated by "|". Same words as
# my local, git-ignored private word list (npm run eval checks they match).
# Set here and in Vercel only; never committed. Required in production.
PRIVATE_TERMS=

# Optional secret for hashing visitor addresses in rate-limit keys. If empty, the
# Upstash token is used, which means anyone holding that token could reverse the hashes.
RATE_LIMIT_HMAC_SECRET=

# Optional rate limits (defaults 5 per minute and 30 per day per visitor, 300 per day in total).
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_PER_DAY=
RATE_LIMIT_GLOBAL_PER_DAY=

# Short-lived debug logging of chat text. Off unless set to "true".
CHAT_DEBUG_LOG=

# Local only, never set in Vercel (ADR 005).
SHOW_EXAMPLE=
ALLOW_EXAMPLE_BUILD=
